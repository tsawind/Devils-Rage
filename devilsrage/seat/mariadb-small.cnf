# Small-server settings for SeAT's own MariaDB (shared 3.7 GB VPS).
# Raise innodb_buffer_pool_size later if SeAT feels slow and RAM allows.
[mysqld]
innodb_buffer_pool_size = 128M
innodb_log_buffer_size  = 8M
key_buffer_size         = 8M
tmp_table_size          = 16M
max_heap_table_size     = 16M
max_connections         = 40
performance_schema      = OFF
